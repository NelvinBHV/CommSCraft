<component type="desktop-application">
  <id>io.github.NelvinBHV.CommSCraft</id>
  <name>CommSCraft</name>
  <summary>Open-source client for on-premises Skype for Business Server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <description>
    <p>CommSCraft is a clean-room Linux client for on-premises Skype for Business Server, built
    from published protocol specifications: sign-in, contacts and presence, chat, audio and video
    calls, meetings and viewing shared screens.</p>
    <p>Experimental software for development and testing on authorized systems.</p>
  </description>
